@startuml
skinparam shadowing false

package "Transport (gin)" {
  [Routes] as Routes
  [middleware.CORS]
  [middleware.Auth]
  [middleware.RequireRole]
}

package "Handlers" {
  [auth.handler]
  [class.handler]
  [exam.handler]
  [submission.handler]
  [problem.handler]
  [testcase.handler]
  [profile.handler]
  [announcement.handler]
  [folder.handler]
  [notification.handler]
  [teacher.handler]
  [student.handler]
  [execute.handler]
}

package "Domain services" {
  [judge0.RunCode]
  [judge0.Grade]
  [judge0.GradeMCQ]
  [judge0.GradeWritten]
  [judge0.FinalizeAttempt]
  [reminder.runOnce]
  [notification.Create]
  [email.Send]
}

package "Persistence" {
  [database.DB]
  [models]
  database "Postgres" as PG
}

Routes --> [middleware.CORS]
Routes --> [middleware.Auth]
Routes --> [middleware.RequireRole]
Routes --> [exam.handler]
[exam.handler] --> [judge0.Grade]
[exam.handler] --> [judge0.GradeMCQ]
[exam.handler] --> [judge0.GradeWritten]
[submission.handler] --> [judge0.FinalizeAttempt]
[judge0.Grade] --> [database.DB]
[judge0.Grade] --> [judge0.RunCode]
[reminder.runOnce] --> [database.DB]
[reminder.runOnce] --> [email.Send]
[notification.Create] --> [database.DB]
[notification.Create] --> [email.Send]
[database.DB] --> PG
@enduml
