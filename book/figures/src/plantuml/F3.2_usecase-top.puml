@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor Teacher
actor Student
actor "Background Scheduler" as Sched

rectangle "APEX" {
  usecase "Authenticate (password / Google)" as UC1
  usecase "Reset password" as UC2
  usecase "Manage classes" as UC3
  usecase "Build exams" as UC4
  usecase "Assign exams to classes" as UC5
  usecase "Grade written answers" as UC6
  usecase "Announce grades" as UC7
  usecase "Join class by invite code" as UC8
  usecase "Take timed exam" as UC9
  usecase "Resume after autosave" as UC10
  usecase "Review results & feedback" as UC11
  usecase "Send exam reminders" as UC12
  usecase "Finalize and notify on grade" as UC13
}

Teacher --> UC1
Teacher --> UC3
Teacher --> UC4
Teacher --> UC5
Teacher --> UC6
Teacher --> UC7
Student --> UC1
Student --> UC2
Student --> UC8
Student --> UC9
Student --> UC10
Student --> UC11
Sched --> UC12
Sched --> UC13
@enduml
