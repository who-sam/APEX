@startuml
skinparam shadowing false

[BrowserRouter] as BR
[AuthProvider] as AP
[QueryClientProvider?] as QC
[App.tsx] as App
[AppRoutes] as AR
[DashboardLayout] as DL

BR --> App
App --> AP
AP --> AR
AR --> DL

note right of AP
  AuthProvider exposes:
   user, token, login,
   signup, loginWithGoogle,
   logout
  Backed by localStorage
  ("kernel-token", "kernel-role")
end note
@enduml
