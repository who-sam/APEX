@startuml
skinparam shadowing false

start
:main();
:cfg = config.Load();
:database.Connect(cfg)\n  -> RunMigrations\n  -> AutoMigrate\n  -> RunPostMigrations;
:auth.Init(cfg);
:email.Init(cfg);
:judge0.Init(cfg.Judge0URL);
:reminder.Start()  // goroutine ticker;
:r = gin.Default();
:r.Use(middleware.CORS());
:public  = r.Group("/api");
:protected = r.Group("/api")\n  .Use(middleware.Auth(cfg.JWTSecret));
fork
  :auth.RegisterRoutes(public, protected);
fork again
  :class.RegisterRoutes(...);
fork again
  :exam.RegisterRoutes(...);
fork again
  :problem / testcase / submission ...;
fork again
  :student / teacher / profile;
fork again
  :notification / announcement / folder;
fork again
  :execute.RegisterRoutes(...);
end fork
:r.Run(":8080");
stop
@enduml
