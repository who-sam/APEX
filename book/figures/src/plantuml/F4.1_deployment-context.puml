@startuml
skinparam shadowing false
left to right direction

actor Teacher
actor Student

cloud "Browser (Chromium / Firefox)" as B {
  component "React + Vite SPA" as SPA
  component "Monaco editor" as MON
  component "Google Identity Services" as GIS
}

node "APEX server (Linux host)" as Host {
  component "Gin API :8080" as API
  component "Reminder scheduler\n(goroutine)" as Sched
}

database "PostgreSQL 16" as PG

cloud "Judge0 CE (HTTP)" as J0
cloud "SMTP relay (optional)" as SMTP
cloud "Google OAuth" as GOOG

Teacher --> SPA
Student --> SPA
SPA --> API : HTTPS / JSON\nBearer JWT
SPA --> GIS : OAuth dance
GIS --> GOOG
SPA --> MON
API --> PG : GORM
API --> J0 : POST /submissions?wait=true
API --> SMTP : password reset, exam emails
API --> GOOG : idtoken.Validate
Sched --> PG
Sched --> SMTP
@enduml
