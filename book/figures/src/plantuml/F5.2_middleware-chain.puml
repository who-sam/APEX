@startuml
skinparam shadowing false

participant Client
participant Gin
participant CORS
participant Auth as "middleware.Auth"
participant Role as "middleware.RequireRole"
participant H as "Handler"

Client -> Gin : HTTPS request
Gin -> CORS : preflight / headers
CORS -> Auth : if /api/* protected
Auth -> Auth : parse Bearer JWT (HS256)
Auth -> Auth : claims["user_id"], ["email"], ["role"]\n with comma-ok type assertions
Auth -> Role : c.Set + c.Next
Role -> Role : check role in allow-list
Role -> H : c.Next
H -> Gin : JSON response
Gin -> Client : 200 / 4xx / 5xx
@enduml
