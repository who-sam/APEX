@startuml
left to right direction
skinparam shadowing false

actor Teacher

rectangle "Teacher use cases" {
  usecase "Create / edit / delete exam" as T1
  usecase "Add coding / MCQ / written problems" as T2
  usecase "Manage test cases (sample vs hidden)" as T3
  usecase "Save problem to bank, organise in folders" as T4
  usecase "Publish exam (requires start_time)" as T5
  usecase "Assign exam to one or many classes" as T6
  usecase "Close / reopen exam window" as T7
  usecase "Grade written submissions, leave feedback" as T8
  usecase "Override score on auto-graded submission" as T9
  usecase "View per-student results & timing" as T10
  usecase "Toggle grades_announced and passing threshold" as T11
  usecase "Post announcements with attachments" as T12
  usecase "Remove members from class" as T13
  usecase "Preview exam as student" as T14
}

Teacher --> T1
Teacher --> T2
Teacher --> T3
Teacher --> T4
Teacher --> T5
Teacher --> T6
Teacher --> T7
Teacher --> T8
Teacher --> T9
Teacher --> T10
Teacher --> T11
Teacher --> T12
Teacher --> T13
Teacher --> T14

T5 ..> T1 : <<extend>> requires draft
T6 ..> T1 : <<extend>>
T9 ..> T8 : <<extend>>
@enduml
