@startuml
skinparam shadowing false

package "Bootstrap" {
  [main.tsx] --> [App.tsx]
  [App.tsx] --> [AuthProvider]
  [App.tsx] --> [BrowserRouter]
}

package "Routing (app/routes.tsx)" {
  [AppRoutes] --> [DashboardLayout]
  [AppRoutes] --> [AuthPage]
  [DashboardLayout] --> [DashboardIndex]
  [DashboardLayout] --> [ExamsPage\n(role split)]
  [DashboardLayout] --> [ExamBuilder\nTeacherRoute]
  [DashboardLayout] --> [ExamTaking\nStudentRoute]
  [DashboardLayout] --> [GradeWritten\nTeacherRoute]
  [DashboardLayout] --> [Results]
  [DashboardLayout] --> [Profile]
  [DashboardLayout] --> [Settings]
  [DashboardLayout] --> [Courses]
  [DashboardLayout] --> [QuestionBank]
}

package "Cross-cutting" {
  [contexts/AuthContext.tsx] --> [lib/api.ts]
  [contexts/RoleContext.tsx]
  [contexts/UserContext.tsx]
  [components/layout]
  [hooks]
}

[ExamBuilder] --> [lib/api.ts]
[ExamTaking] --> [lib/api.ts]
[GradeWritten] --> [lib/api.ts]
[Results] --> [lib/api.ts]
[lib/api.ts] --> [Gin /api]

note right of [contexts/AuthContext.tsx]
  parseJWT in browser
  to bootstrap user
  from localStorage
end note
@enduml
