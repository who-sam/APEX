@startuml
left to right direction
skinparam shadowing false

actor Student

rectangle "Student use cases" {
  usecase "Sign up / log in (password / Google)" as S1
  usecase "Reset password by email" as S2
  usecase "Join class by 8-char invite code" as S3
  usecase "Leave a class" as S4
  usecase "View assigned exams + countdown" as S5
  usecase "Start timed exam attempt" as S6
  usecase "Edit answers in Monaco" as S7
  usecase "Run sample tests" as S8
  usecase "Autosave drafts every 15 s" as S9
  usecase "Submit attempt" as S10
  usecase "Resume after crash / new device" as S11
  usecase "Review attempt with per-test feedback" as S12
  usecase "Receive in-app + email notifications" as S13
  usecase "Edit profile + notification preferences" as S14
}

Student --> S1
Student --> S2
Student --> S3
Student --> S4
Student --> S5
Student --> S6
Student --> S7
Student --> S8
Student --> S9
Student --> S10
Student --> S11
Student --> S12
Student --> S13
Student --> S14

S9 ..> S6 : <<extend>>
S11 ..> S6 : <<extend>>
S8 ..> S7 : <<extend>> coding only
@enduml
