sequenceDiagram
    autonumber
    actor U as User
    participant SPA as React SPA
    participant API as Gin /api
    participant H as auth.Login
    participant DB as Postgres
    participant BC as bcrypt

    U->>SPA: enter email + password
    SPA->>API: POST /auth/login {email, password}
    API->>H: dispatch
    H->>DB: SELECT user WHERE email=?
    DB-->>H: user row (or 401)
    H->>BC: CompareHashAndPassword(hash, pw)
    BC-->>H: ok / err
    alt password matches
        H->>H: generateToken(user) HS256, 24h exp
        H-->>API: 200 {token, user}
        API-->>SPA: 200 {token, user}
        SPA->>SPA: localStorage.setItem("kernel-token")
        SPA->>SPA: parseJWT → {user_id, role, name}
        SPA-->>U: redirect to /dashboard
    else mismatch
        H-->>API: 401 invalid email or password
        API-->>SPA: 401
        SPA-->>U: show error
    end
