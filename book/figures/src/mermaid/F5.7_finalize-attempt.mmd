flowchart TD
    A[maybeFinalizeAttempt(attemptID)] --> B{attemptID == nil?}
    B -->|yes| Z[return]
    B -->|no| C[count submissions WHERE status IN pending,running]
    C --> D{count > 0?}
    D -->|yes| Z
    D -->|no| E[load attempt + exam.problems]
    E --> F[map subByProblem]
    F --> G[for p in problems]
    G --> H{has sub?}
    H -->|no| I[totalPoints += p.points<br/>earned += 0]
    H -->|yes, status=pending_review| J[skip from numerator AND denominator]
    H -->|yes, graded| K[totalPoints += p.points<br/>earned += score/100 * pts]
    I --> G
    J --> G
    K --> G
    G -->|done| L[pct = earned / total * 100]
    L --> M[UPDATE attempt.score]
    M --> N{any pending_review remaining?}
    N -->|yes| Z
    N -->|no| O{status=submitted AND NOT graded_notified?}
    O -->|yes| P[graded_notified=true<br/>fire Exam Graded notification]
    O -->|no| Z
    P --> Z
