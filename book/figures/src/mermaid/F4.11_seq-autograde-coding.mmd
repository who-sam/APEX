sequenceDiagram
    autonumber
    participant H as exam.SubmitAttempt
    participant G as judge0.Grade(submissionID)
    participant DB as Postgres
    participant J0 as Judge0 sandbox
    participant N as notification.Create
    participant FA as maybeFinalizeAttempt

    H->>G: go Grade(sub.ID)
    G->>DB: SELECT submission
    G->>DB: UPDATE status=running
    G->>DB: SELECT test_cases ORDER BY order_index
    alt no test cases
        G->>DB: status=accepted, score=100
    else has test cases
        loop for each test case
            G->>J0: POST /submissions?wait=true {code, lang, stdin}
            J0-->>G: {stdout, stderr, status, time, memory}
            G->>G: normalizeOutput(actual) == normalizeOutput(expected)
            G->>DB: INSERT test_result
        end
        G->>DB: UPDATE submission {status, score, max time/memory}
    end
    G->>FA: maybeFinalizeAttempt(attempt_id)
    FA->>DB: COUNT pending/running for attempt
    alt none pending
        FA->>DB: aggregate score over exam.problems
        FA->>DB: UPDATE attempt.score = pct
        FA->>N: "Exam Graded" (idempotent via graded_notified)
    end
