# --- Database ---
# In production set DATABASE_URL (and leave DB_* empty). It takes precedence
# over the discrete vars below in both the app and cmd/migrate.
# Neon example (note sslmode=require):
#   DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/apex?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apex
DB_SSLMODE=disable

# --- Server ---
PORT=8080

# Skip GORM AutoMigrate (set to "true" in production once cmd/migrate is the
# source of truth). Leave unset locally so AutoMigrate keeps managing schema.
SKIP_AUTOMIGRATE=

# --- Auth ---
# Required: must be >= 32 chars and not the literal "dev-secret-change-in-prod".
JWT_SECRET=replace-me-with-a-strong-random-secret-32+chars

# --- Code execution ---
JUDGE0_URL=https://ce.judge0.com

# --- Frontend / CORS ---
# Primary frontend origin (used for email links and as a CORS allowlist entry).
APP_URL=http://localhost:5173
# Optional comma-separated additional CORS origins (e.g. Vercel preview URLs).
ALLOWED_ORIGINS=

# --- Email (optional) ---
# Leave SMTP_HOST empty in dev — links are logged to console.
# Gmail: enable 2FA then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Google OAuth (optional) ---
# Web client ID from Google Cloud Console. Must match VITE_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_CLIENT_ID=
